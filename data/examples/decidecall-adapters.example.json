{
  "schema": 1,
  "_about": "Copy to the company folder as decidecall-adapters.json (or ~/.decidecall/adapters.json) and keep only the programs that are installed. decidecall runs each command itself, with no shell, and talks to it through standard input and output; it never opens a connection of its own. An adapter of kind \"embed\" gives the cache meaning: decidecall sends it {\"model\", \"input\": [texts]} (ollama /api/embed; for llama.cpp --embeddings or any server with /v1/embeddings change the address). Kinds \"ollama\" and \"openai-chat\" hand the output schema to the runner, which decodes only that shape. `keychain` names secrets decidecall reads from the computer's keychain into the adapter's environment; curl takes them with --variable and --expand-header, so no key is ever written in this file or on a command line.",
  "adapters": [
    {
      "id": "meaning-ollama",
      "kind": "embed",
      "model": "nomic-embed-text",
      "command": [
        "curl",
        "-sS",
        "--max-time",
        "2",
        "http://127.0.0.1:11434/api/embed",
        "-H",
        "content-type: application/json",
        "--data-binary",
        "@-"
      ],
      "location": "local"
    },
    {
      "id": "strands-local",
      "tier": "local",
      "kind": "strands-cli",
      "command": [
        "strands-decider",
        "ask",
        "StrandsAgents/strands-decider-2B-hobson-v19",
        "--state",
        "{state}",
        "--choice",
        "{question}={options_csv}"
      ],
      "provider": "local",
      "location": "local",
      "usd_per_mtok_in": 0,
      "usd_per_mtok_out": 0,
      "family": "strands-decider"
    },
    {
      "id": "openjev-local",
      "tier": "local",
      "kind": "systemone",
      "command": [
        "curl",
        "-sS",
        "http://127.0.0.1:8000/v1/systemone",
        "-H",
        "content-type: application/json",
        "--data-binary",
        "@-"
      ],
      "provider": "local",
      "location": "local",
      "usd_per_mtok_in": 0,
      "usd_per_mtok_out": 0,
      "family": "openjev"
    },
    {
      "id": "ollama-qwen",
      "tier": "local",
      "kind": "decision-json",
      "command": [
        "ollama",
        "run",
        "qwen3.6:35b-a3b",
        "--format",
        "json",
        "{prompt}"
      ],
      "provider": "local",
      "location": "local",
      "usd_per_mtok_in": 0,
      "usd_per_mtok_out": 0,
      "family": "qwen"
    },
    {
      "id": "ollama-qwen-strict",
      "tier": "local",
      "kind": "ollama",
      "model": "qwen3.6:35b-a3b",
      "command": [
        "curl",
        "-sS",
        "--max-time",
        "120",
        "http://127.0.0.1:11434/api/generate",
        "-H",
        "content-type: application/json",
        "--data-binary",
        "@-"
      ],
      "provider": "local",
      "location": "local",
      "family": "qwen",
      "usd_per_mtok_in": 0,
      "usd_per_mtok_out": 0
    },
    {
      "id": "llamacpp-strict",
      "tier": "local",
      "kind": "openai-chat",
      "model": "local",
      "command": [
        "curl",
        "-sS",
        "--max-time",
        "120",
        "http://127.0.0.1:8080/v1/chat/completions",
        "-H",
        "content-type: application/json",
        "--data-binary",
        "@-"
      ],
      "provider": "local",
      "location": "local",
      "family": "llamacpp",
      "usd_per_mtok_in": 0,
      "usd_per_mtok_out": 0
    },
    {
      "id": "haiku",
      "tier": "cheap",
      "kind": "decision-json",
      "command": [
        "claude",
        "-p",
        "--model",
        "haiku",
        "--output-format",
        "json",
        "--tools",
        "",
        "--strict-mcp-config",
        "--system-prompt",
        "You take one decision. Answer only with the JSON asked for.",
        "--json-schema",
        "{schema}",
        "{prompt}"
      ],
      "provider": "anthropic",
      "location": "cloud",
      "zdr": false,
      "usd_per_mtok_in": 1.0,
      "usd_per_mtok_out": 5.0,
      "family": "claude-haiku"
    },
    {
      "id": "jev",
      "tier": "cheap",
      "kind": "systemone",
      "command": [
        "curl",
        "-sS",
        "--variable",
        "%TYPESAFE_API_KEY",
        "--expand-header",
        "Authorization: Bearer {{TYPESAFE_API_KEY}}",
        "-H",
        "content-type: application/json",
        "--data-binary",
        "@-",
        "https://api.typesafe.ai/v1/systemone"
      ],
      "provider": "typesafe",
      "location": "cloud",
      "zdr": false,
      "usd_per_mtok_in": 0.042,
      "usd_per_mtok_out": 0,
      "keychain": {
        "TYPESAFE_API_KEY": "typesafe-api-key"
      },
      "family": "jev"
    },
    {
      "id": "opus",
      "tier": "strong",
      "kind": "decision-json",
      "command": [
        "claude",
        "-p",
        "--model",
        "opus",
        "--output-format",
        "json",
        "--tools",
        "",
        "--strict-mcp-config",
        "--system-prompt",
        "You take one decision. Answer only with the JSON asked for.",
        "--json-schema",
        "{schema}",
        "{prompt}"
      ],
      "provider": "anthropic",
      "location": "cloud",
      "zdr": false,
      "usd_per_mtok_in": 4.0,
      "usd_per_mtok_out": 20.0,
      "family": "claude-opus"
    }
  ]
}
